# libjxl reference build pin
# Sourced by reference shell scripts and parsed by PinRecord in tests.
LIBJXL_URL="https://github.com/libjxl/libjxl.git"
LIBJXL_TAG="v0.12.0"
LIBJXL_COMMIT="a7a9c787341cf703dede03c2009fa460cae5e5df"

# Submodule pins recorded at libjxl commit a7a9c787
HIGHWAY_COMMIT="457c891775a7397bdb0376bb1031e6e027af1c48"
BROTLI_COMMIT="028fb5a23661f123017c060daa546b55cf4bde29"
SKCMS_COMMIT="96d9171c94b937a1b5f0293de7309ac16311b722"
TESTDATA_COMMIT="73695d303670c90e4d506ea89d9901b081385089"

# Build configuration
CMAKE_FLAGS_RELEASE="-DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DJPEGXL_ENABLE_BENCHMARK=OFF -DJPEGXL_ENABLE_EXAMPLES=OFF -DJPEGXL_ENABLE_DOXYGEN=OFF -DJPEGXL_ENABLE_MANPAGES=OFF -DJPEGXL_ENABLE_JNI=OFF -DJPEGXL_ENABLE_TCMALLOC=OFF -DJPEGXL_ENABLE_PLUGINS=OFF -DJPEGXL_FORCE_SYSTEM_LCMS2=ON -DJPEGXL_ENABLE_SJPEG=OFF -DJPEGXL_BUNDLE_LIBPNG=OFF"
CMAKE_FLAGS_DEBUG="-DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=OFF -DJPEGXL_ENABLE_BENCHMARK=OFF -DJPEGXL_ENABLE_EXAMPLES=OFF -DJPEGXL_ENABLE_DOXYGEN=OFF -DJPEGXL_ENABLE_MANPAGES=OFF -DJPEGXL_ENABLE_JNI=OFF -DJPEGXL_ENABLE_TCMALLOC=OFF -DJPEGXL_ENABLE_PLUGINS=OFF -DJPEGXL_FORCE_SYSTEM_LCMS2=ON -DJPEGXL_ENABLE_SJPEG=OFF -DJPEGXL_BUNDLE_LIBPNG=OFF"

# JPEG dependency
JPEG_TURBO_VERSION="3.2.0"
